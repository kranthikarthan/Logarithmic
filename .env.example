# Xray Test Management Tool Configuration
# Copy this file to .env and update the values

# Flask secret key for session management
SECRET_KEY=your-secret-key-change-this-to-something-secure

# Default Jira configuration (optional - can be set in the UI)
DEFAULT_JIRA_URL=https://your-domain.atlassian.net
DEFAULT_USERNAME=your-email@company.com
DEFAULT_API_TOKEN=your-api-token-here

# Application settings
DEBUG=True
HOST=0.0.0.0
PORT=5000